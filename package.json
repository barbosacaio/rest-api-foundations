{
  "name": "rest-api-foundations",
  "version": "1.0.0",
  "description": "A production-minded REST API focused on HTTP fundamentals, validation, relational data modeling, and automated testing.",
  "homepage": "https://github.com/barbosacaio/rest-api-foundations#readme",
  "bugs": {
    "url": "https://github.com/barbosacaio/rest-api-foundations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barbosacaio/rest-api-foundations.git"
  },
  "license": "UNLICENSED",
  "author": "https://github.com/barbosacaio",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import=tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
